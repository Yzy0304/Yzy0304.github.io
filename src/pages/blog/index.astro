---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Blog · Zhenyu Yao" description="Notes on computer vision, vision-language models, and anomaly detection.">
  <h1 style="margin-top:0">Blog</h1>
  <p class="post-meta">Notes on computer vision, vision-language models, and anomaly detection. Posts are written in Chinese or English.</p>
  {posts.length === 0 ? (
    <p class="empty">No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${base}/blog/${post.id}/`} lang={post.data.lang === 'zh' ? 'zh-CN' : 'en'}>{post.data.title}</a>
          {post.data.draft && <strong> [draft]</strong>}
          <div><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.length > 0 && ` · ${post.data.tags.join(' · ')}`}</div>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
