---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const p = profile[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = lang === 'zh' ? `${base}/zh/` : `${base}/`;
const otherHome = lang === 'zh' ? `${base}/` : `${base}/zh/`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? p.summary} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? p.summary} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog" href={`${base}/rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-inner">
        <a class="brand" href={home}>{p.name}</a>
        <nav class="site-nav" aria-label="Main">
          <a href={`${home}#bio`}>{p.nav.bio}</a>
          <a href={`${home}#research`}>{p.nav.research}</a>
          <a href={`${home}#projects`}>{p.nav.projects}</a>
          <a href={`${home}#education`}>{p.nav.education}</a>
          <a href={`${base}/blog/`} aria-current={path.startsWith(`${base}/blog`) ? 'page' : undefined}>{p.nav.blog}</a>
        </nav>
        <div class="nav-tools">
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <span class="when-light"><Icon name="moon" /></span>
            <span class="when-dark"><Icon name="sun" /></span>
          </button>
          <a class="lang-switch" href={otherHome} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{p.nav.switchLang}</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {p.name} · <a href="https://github.com/Yzy0304">GitHub</a></div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
