---
import '../styles/global.css';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const p = profile[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = lang === 'zh' ? `${base}/zh/` : `${base}/`;
const otherHome = lang === 'zh' ? `${base}/` : `${base}/zh/`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? p.summary} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? p.summary} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={home}>{p.name}</a>
        <nav class="site-nav" aria-label="Main">
          <a href={`${home}#research`}>{p.nav.research}</a>
          <a href={`${home}#projects`}>{p.nav.projects}</a>
          <a href={`${home}#education`}>{p.nav.education}</a>
          <a href={`${base}/blog/`} aria-current={path.startsWith(`${base}/blog`) ? 'page' : undefined}>{p.nav.blog}</a>
          <a href={otherHome} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{p.nav.switchLang}</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {p.name} · <a href="https://github.com/Yzy0304">GitHub</a></div>
    </footer>
  </body>
</html>
