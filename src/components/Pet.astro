---
// A small desk pet that doubles as an offline assistant. It answers questions
// about Zhenyu from profile.ts (see src/lib/assistant.ts); no API is called.
import Icon from './Icon.astro';
import { petName } from '../lib/assistant';
import { base } from '../lib/i18n';
import type { Lang } from '../data/profile';

interface Props { lang: Lang; home?: boolean }
const { lang, home = false } = Astro.props;
const t = lang === 'zh'
  ? {
      open: `和 ${petName} 聊天`,
      status: '离线模式 · 只了解振宇的主页信息',
      placeholder: '问问振宇的情况…',
      send: '发送',
      close: '关闭',
      clear: '清空对话',
      bubble: `嗨！我是 ${petName} 👋 想了解振宇？点我聊聊吧。`,
    }
  : {
      open: `Chat with ${petName}`,
      status: "Offline · knows Zhenyu's profile",
      placeholder: 'Ask about Zhenyu…',
      send: 'Send',
      close: 'Close',
      clear: 'Clear chat',
      bubble: `Hi! I'm ${petName} 👋 Curious about Zhenyu? Tap me to chat.`,
    };
---

<div class="pet-root" data-lang={lang} data-base={base} data-home={home ? '1' : undefined} data-state="idle">
  <p class="pet-bubble" hidden>
    <span>{t.bubble}</span>
    <button type="button" class="pet-bubble-x" aria-label={t.close}><Icon name="close" size={12} /></button>
  </p>

  <section class="pet-chat" id="pet-chat" role="dialog" aria-label={t.open} hidden>
    <header class="pet-head">
      <span class="pet-avatar" aria-hidden="true">
        <svg viewBox="0 0 120 120"><use href="#pet-face" /></svg>
      </span>
      <div>
        <strong>{petName}</strong>
        <span class="pet-status"><i></i>{t.status}</span>
      </div>
      <button type="button" class="pet-icon-btn pet-clear" aria-label={t.clear} title={t.clear}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      </button>
      <button type="button" class="pet-icon-btn pet-close" aria-label={t.close}><Icon name="close" size={16} /></button>
    </header>
    <div class="pet-log" aria-live="polite"></div>
    <div class="pet-suggest"></div>
    <form class="pet-form">
      <input type="text" name="q" autocomplete="off" placeholder={t.placeholder} aria-label={t.placeholder} maxlength="200" />
      <button type="submit" aria-label={t.send}><Icon name="arrow" size={16} /></button>
    </form>
  </section>

  <button type="button" class="pet" aria-label={t.open} aria-expanded="false" aria-controls="pet-chat">
    <svg class="pet-svg" viewBox="0 0 120 120" aria-hidden="true">
      <defs>
        <linearGradient id="pet-body" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7d7aff" />
          <stop offset="0.55" stop-color="#5e5ce6" />
          <stop offset="1" stop-color="#0a84ff" />
        </linearGradient>
        <linearGradient id="pet-shine" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <g id="pet-face">
          <rect x="12" y="24" width="96" height="84" rx="32" fill="url(#pet-body)" />
          <rect x="22" y="28" width="76" height="26" rx="13" fill="url(#pet-shine)" />
          <rect x="24" y="42" width="72" height="48" rx="18" fill="#101014" />
          <rect class="eye" x="43" y="54" width="9" height="16" rx="4.5" fill="#7cf3ff" />
          <rect class="eye" x="68" y="54" width="9" height="16" rx="4.5" fill="#7cf3ff" />
        </g>
      </defs>
      <g class="pet-bob">
        <g class="pet-arm left"><rect x="2" y="64" width="16" height="10" rx="5" fill="#5e5ce6" /></g>
        <g class="pet-arm right"><rect x="102" y="64" width="16" height="10" rx="5" fill="#0a84ff" /></g>
        <line x1="60" y1="24" x2="60" y2="10" stroke="#5e5ce6" stroke-width="4" stroke-linecap="round" />
        <circle class="pet-antenna" cx="60" cy="8" r="6" fill="#ff9f0a" />
        <rect x="12" y="24" width="96" height="84" rx="32" fill="url(#pet-body)" />
        <rect x="22" y="28" width="76" height="26" rx="13" fill="url(#pet-shine)" />
        <rect x="24" y="42" width="72" height="48" rx="18" fill="#101014" />
        <g class="pet-look">
          <g class="pet-eyes">
            <rect x="43" y="54" width="9" height="16" rx="4.5" fill="#7cf3ff" />
            <rect x="68" y="54" width="9" height="16" rx="4.5" fill="#7cf3ff" />
          </g>
          <g class="pet-happy" fill="none" stroke="#7cf3ff" stroke-width="4" stroke-linecap="round">
            <path d="M42 64q5-8 10 0M67 64q5-8 10 0" />
          </g>
          <rect class="pet-cursor" x="56" y="76" width="8" height="3" rx="1.5" fill="#7cf3ff" />
        </g>
        <ellipse cx="34" cy="80" rx="5" ry="3" fill="#ff6482" opacity="0.55" />
        <ellipse cx="86" cy="80" rx="5" ry="3" fill="#ff6482" opacity="0.55" />
      </g>
    </svg>
    <span class="pet-shadow" aria-hidden="true"></span>
  </button>
</div>

<script>
  import { reply, suggestions, petName, type Reply } from '../lib/assistant';
  import type { Lang } from '../data/profile';

  const root = document.querySelector<HTMLElement>('.pet-root')!;
  const lang = root.dataset.lang as Lang;
  const base = root.dataset.base ?? '';
  const petBtn = root.querySelector<HTMLButtonElement>('.pet')!;
  const chat = root.querySelector<HTMLElement>('.pet-chat')!;
  const log = root.querySelector<HTMLElement>('.pet-log')!;
  const suggest = root.querySelector<HTMLElement>('.pet-suggest')!;
  const form = root.querySelector<HTMLFormElement>('.pet-form')!;
  const input = form.querySelector('input')!;
  const bubble = root.querySelector<HTMLElement>('.pet-bubble')!;
  const look = root.querySelector<SVGGElement>('.pet-look')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Msg = { from: 'me' | 'pet'; text: string; links?: Reply['links'] };
  const KEY = `petChat:${lang}`;
  let history: Msg[] = [];
  try { history = JSON.parse(sessionStorage.getItem(KEY) ?? '[]'); } catch (e) {}
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(history.slice(-40))); } catch (e) {} };

  const setState = (s: string) => (root.dataset.state = s);
  const scrollDown = () => (log.scrollTop = log.scrollHeight);

  function bubbleEl(m: Msg) {
    const el = document.createElement('div');
    el.className = `pet-msg from-${m.from}`;
    const p = document.createElement('p');
    p.textContent = m.text;
    el.append(p);
    if (m.links?.length) el.append(linksEl(m.links));
    return el;
  }
  function linksEl(links: NonNullable<Reply['links']>) {
    const row = document.createElement('div');
    row.className = 'pet-links';
    for (const l of links) {
      const a = document.createElement('a');
      a.href = l.href;
      a.textContent = l.label;
      if (/^https?:/.test(l.href)) { a.target = '_blank'; a.rel = 'noopener'; }
      row.append(a);
    }
    return row;
  }
  function setSuggestions(list: string[]) {
    suggest.replaceChildren(
      ...list.map((q) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = q;
        b.addEventListener('click', () => ask(q));
        return b;
      }),
    );
  }

  let busy = false;
  async function say(r: Reply) {
    busy = true;
    setState('thinking');
    const typing = document.createElement('div');
    typing.className = 'pet-msg from-pet typing';
    typing.innerHTML = '<p><i></i><i></i><i></i></p>';
    log.append(typing);
    scrollDown();
    await new Promise((res) => setTimeout(res, reduce ? 150 : 450 + Math.min(r.text.length * 6, 700)));
    typing.remove();

    const msg: Msg = { from: 'pet', text: r.text, links: r.links };
    const el = bubbleEl({ from: 'pet', text: '' });
    const p = el.querySelector('p')!;
    log.append(el);
    setState('talking');
    if (reduce) p.textContent = r.text;
    else {
      // Stream the answer a few characters per frame.
      for (let i = 0; i < r.text.length; i += 3) {
        p.textContent = r.text.slice(0, i + 3);
        scrollDown();
        await new Promise((res) => requestAnimationFrame(res));
      }
    }
    if (r.links?.length) el.append(linksEl(r.links));
    history.push(msg);
    save();
    setSuggestions(r.suggest ?? []);
    scrollDown();
    setState(chat.hidden ? 'idle' : 'listening');
    busy = false;
  }

  function ask(q: string) {
    q = q.trim();
    if (!q || busy) return;
    const m: Msg = { from: 'me', text: q };
    history.push(m);
    log.append(bubbleEl(m));
    setSuggestions([]);
    input.value = '';
    scrollDown();
    say(reply(q, lang, base));
  }

  function greet() {
    say({
      text: lang === 'zh'
        ? `你好！我是 ${petName}，振宇的小助手 ✨ 我可以介绍他的学业、科研、项目、技能和联系方式。想先了解什么？`
        : `Hi! I'm ${petName}, Zhenyu's little assistant ✨ I can tell you about his studies, research, projects, skills, and how to reach him. Where should we start?`,
      suggest: suggestions(lang),
    });
  }

  function open(question?: string) {
    hideBubble();
    if (chat.hidden) {
      chat.hidden = false;
      requestAnimationFrame(() => chat.classList.add('open'));
      petBtn.setAttribute('aria-expanded', 'true');
      setState('listening');
      if (log.childElementCount === 0) {
        if (history.length) {
          history.forEach((m) => log.append(bubbleEl(m)));
          setSuggestions(suggestions(lang).slice(0, 3));
          scrollDown();
        } else if (!question) greet();
      }
    }
    if (question) ask(question);
    else if (matchMedia('(pointer: fine)').matches) input.focus();
  }
  function close() {
    chat.classList.remove('open');
    petBtn.setAttribute('aria-expanded', 'false');
    setState('idle');
    setTimeout(() => { if (!chat.classList.contains('open')) chat.hidden = true; }, 250);
    petBtn.focus();
  }

  petBtn.addEventListener('click', () => (chat.hidden ? open() : close()));
  root.querySelector('.pet-close')!.addEventListener('click', close);
  root.querySelector('.pet-clear')!.addEventListener('click', () => {
    if (busy) return;
    history = [];
    save();
    log.replaceChildren();
    greet();
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !chat.hidden) close(); });
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-open-pet]');
    if (trigger) { e.preventDefault(); open(trigger.dataset.ask); }
  });

  // Greeting bubble on the home page, once per session.
  function hideBubble() { bubble.hidden = true; }
  bubble.querySelector('.pet-bubble-x')!.addEventListener('click', hideBubble);
  bubble.querySelector('span')!.addEventListener('click', () => open());
  if (root.dataset.home) {
    let greeted = false;
    try { greeted = !!sessionStorage.getItem('petGreeted'); } catch (e) {}
    if (!greeted) {
      const show = () => setTimeout(() => {
        if (!chat.hidden) return;
        bubble.hidden = false;
        setState('wave');
        setTimeout(() => setState(chat.hidden ? 'idle' : 'listening'), 2400);
        try { sessionStorage.setItem('petGreeted', '1'); } catch (e) {}
      }, 1400);
      if (document.getElementById('intro')) addEventListener('intro:done', show, { once: true });
      else show();
    }
  }

  // Eyes follow the pointer.
  if (!reduce) {
    let frame = 0;
    addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = petBtn.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const d = Math.hypot(dx, dy) || 1;
        const k = Math.min(1, d / 300);
        look.style.transform = `translate(${((dx / d) * 5 * k).toFixed(2)}px, ${((dy / d) * 4 * k).toFixed(2)}px)`;
      });
    });
  }
</script>

<style is:global>
  .pet-root {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
    font-family: var(--font);
  }
  .pet {
    position: relative; width: 76px; height: 76px; padding: 0; border: 0; background: none; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .pet:focus-visible { outline-offset: 2px; border-radius: 24px; }
  .pet-svg { position: relative; z-index: 1; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 8px 14px rgba(94, 92, 230, 0.35)); }
  .pet-shadow {
    position: absolute; left: 18%; right: 18%; bottom: -4px; height: 8px; border-radius: 50%;
    background: rgba(0, 0, 0, 0.18); filter: blur(3px); animation: pet-shadow 3.2s ease-in-out infinite;
  }
  .pet-bob { animation: pet-bob 3.2s ease-in-out infinite; transform-origin: 60px 108px; transform-box: view-box; }
  .pet-look { transition: transform 0.25s ease-out; }
  .pet-eyes { animation: pet-blink 4.6s infinite; transform-origin: 60px 62px; transform-box: view-box; }
  .pet-happy { opacity: 0; }
  .pet-cursor { animation: pet-cursor 1.1s steps(1) infinite; }
  .pet-antenna { transition: fill 0.3s; }
  .pet-arm { transform-box: view-box; transition: transform 0.3s; }
  .pet-arm.left { transform-origin: 18px 69px; }
  .pet-arm.right { transform-origin: 102px 69px; }
  .pet:hover .pet-bob { animation-duration: 1.4s; }
  .pet:hover .pet-eyes, [data-state='wave'] .pet-eyes, [data-state='talking'] .pet-eyes { opacity: 0; }
  .pet:hover .pet-happy, [data-state='wave'] .pet-happy, [data-state='talking'] .pet-happy { opacity: 1; }
  [data-state='wave'] .pet-arm.right { animation: pet-wave 0.5s ease-in-out 4 alternate; }
  [data-state='thinking'] .pet-antenna { animation: pet-glow 0.5s infinite alternate; }
  [data-state='thinking'] .pet-eyes { animation: pet-scan 1s ease-in-out infinite alternate; }
  [data-state='talking'] .pet-bob { animation: pet-hop 0.4s ease-in-out infinite alternate; }
  [data-state='listening'] .pet-antenna { fill: #30d158; }

  @keyframes pet-bob { 50% { transform: translateY(-5px); } }
  @keyframes pet-shadow { 50% { transform: scaleX(0.82); opacity: 0.7; } }
  @keyframes pet-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes pet-cursor { 50% { opacity: 0; } }
  @keyframes pet-wave { from { transform: rotate(10deg); } to { transform: rotate(-40deg); } }
  @keyframes pet-glow { from { fill: #ff9f0a; } to { fill: #ffd60a; } }
  @keyframes pet-scan { from { transform: translateX(-4px); } to { transform: translateX(4px); } }
  @keyframes pet-hop { to { transform: translateY(-3px) scale(1.02, 0.98); } }

  .pet-bubble {
    position: relative; max-width: 250px; margin: 0 6px 0 0; padding: 12px 34px 12px 16px;
    border-radius: 18px 18px 6px 18px; background: var(--overlay); color: var(--text);
    backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.14); border: 1px solid var(--border);
    font-size: 14px; line-height: 1.4; letter-spacing: -0.01em;
    animation: pet-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pet-bubble span { cursor: pointer; }
  .pet-bubble-x {
    position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 20px; height: 20px;
    border: 0; border-radius: 50%; background: var(--fill); color: var(--muted); cursor: pointer; padding: 0;
  }
  @keyframes pet-pop { from { opacity: 0; transform: translateY(8px) scale(0.92); } }

  .pet-chat {
    width: min(380px, calc(100vw - 32px)); height: min(560px, calc(100dvh - 140px));
    display: flex; flex-direction: column; overflow: hidden;
    border-radius: 24px; background: var(--chat-bg); color: var(--text);
    backdrop-filter: saturate(180%) blur(28px); -webkit-backdrop-filter: saturate(180%) blur(28px);
    border: 1px solid var(--border); box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
    transform-origin: bottom right; opacity: 0; transform: translateY(12px) scale(0.96);
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .pet-chat.open { opacity: 1; transform: none; }
  .pet-chat[hidden] { display: none; }
  .pet-head { display: flex; align-items: center; gap: 10px; padding: 14px 12px 12px 16px; border-bottom: 1px solid var(--border); }
  .pet-head > div { flex: 1; min-width: 0; display: grid; }
  .pet-head strong { font-size: 15px; letter-spacing: -0.01em; }
  .pet-status { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pet-status i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); flex: none; }
  .pet-avatar { width: 34px; height: 34px; flex: none; }
  .pet-avatar svg { width: 100%; height: 100%; }
  .pet-icon-btn {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%;
    border: 0; background: var(--fill); color: var(--muted); cursor: pointer;
  }
  .pet-icon-btn:hover { color: var(--text); }
  .pet-log { flex: 1; overflow-y: auto; padding: 16px 14px 6px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .pet-msg { max-width: 86%; animation: pet-in 0.3s ease-out; }
  .pet-msg p { margin: 0; padding: 9px 14px; border-radius: 18px; font-size: 14.5px; line-height: 1.42; letter-spacing: -0.01em; white-space: pre-wrap; word-break: break-word; }
  .pet-msg.from-pet { align-self: flex-start; }
  .pet-msg.from-pet p { background: var(--card); border-bottom-left-radius: 6px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06); }
  .pet-msg.from-me { align-self: flex-end; }
  .pet-msg.from-me p { background: var(--accent); color: #fff; border-bottom-right-radius: 6px; }
  .pet-msg.typing p { display: flex; gap: 4px; padding: 13px 14px; }
  .pet-msg.typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); animation: pet-dot 1s infinite; }
  .pet-msg.typing i:nth-child(2) { animation-delay: 0.15s; }
  .pet-msg.typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pet-dot { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  @keyframes pet-in { from { opacity: 0; transform: translateY(6px); } }
  .pet-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .pet-links a { font-size: 13px; padding: 4px 10px; border-radius: 999px; background: var(--fill); color: var(--link); }
  .pet-links a:hover { text-decoration: none; filter: brightness(0.96); }
  .pet-suggest { display: flex; gap: 6px; padding: 4px 14px 8px; overflow-x: auto; scrollbar-width: none; }
  .pet-suggest:empty { display: none; }
  .pet-suggest button {
    flex: none; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--hairline); background: transparent;
    color: var(--text); font: inherit; font-size: 13px; cursor: pointer; letter-spacing: -0.01em;
  }
  .pet-suggest button:hover { border-color: var(--accent); color: var(--accent); }
  .pet-form { display: flex; gap: 8px; padding: 10px 12px 12px; border-top: 1px solid var(--border); }
  .pet-form input {
    flex: 1; min-width: 0; height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--hairline);
    background: var(--card); color: var(--text); font: inherit; font-size: 15px; letter-spacing: -0.01em;
  }
  .pet-form input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.2); }
  .pet-form button {
    display: grid; place-items: center; width: 38px; height: 38px; flex: none; border: 0; border-radius: 50%;
    background: var(--accent); color: #fff; cursor: pointer; transform: rotate(-90deg);
  }

  @media (max-width: 560px) {
    .pet-root { right: 14px; bottom: 14px; }
    .pet { width: 62px; height: 62px; }
    .pet-chat { width: calc(100vw - 28px); height: min(560px, calc(100dvh - 120px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pet-bob, .pet-shadow, .pet-eyes, .pet-cursor { animation: none !important; }
  }
</style>
