---
// Chibi Felix in the style of K-pop idol characters (big head, small body,
// glossy eyes): medium-length comma-bang hair, headset mic, black stage
// jacket with gold trim. Class names (pet-eyes, pet-look, pet-mouth…) are
// animated by Pet.astro; `id` keeps gradient ids unique per instance.
interface Props { id: string; class?: string; viewBox?: string }
const { id, class: cls, viewBox = '0 0 120 120' } = Astro.props;
const g = (name: string) => `${id}-${name}`;
const url = (name: string) => `url(#${g(name)})`;
---

<svg class={cls} viewBox={viewBox} aria-hidden="true">
  <defs>
    <linearGradient id={g('hair')} x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#3d3550" />
      <stop offset="0.55" stop-color="#231f2e" />
      <stop offset="1" stop-color="#141219" />
    </linearGradient>
    <linearGradient id={g('skin')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffefe4" />
      <stop offset="1" stop-color="#fbd9c4" />
    </linearGradient>
    <linearGradient id={g('jacket')} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#3b394d" />
      <stop offset="1" stop-color="#18171f" />
    </linearGradient>
    <radialGradient id={g('iris')} cx="0.5" cy="0.7" r="0.75">
      <stop offset="0" stop-color="#9a6a4c" />
      <stop offset="0.55" stop-color="#4a2c22" />
      <stop offset="1" stop-color="#1b1216" />
    </radialGradient>
  </defs>

  <g class="pet-bob">
    <!-- hair volume behind the face, ending at the jaw -->
    <path d="M33 47C31 27 44 15 60 15S89 27 87 47C87 55 86 60.5 83.5 65.5 81 63.5 79.5 61.5 78.5 59.5H41.5C40.5 61.5 39 63.5 36.5 65.5 34 60.5 33 55 33 47Z" fill={url('hair')} />

    <!-- legs and sneakers -->
    <path d="M49.5 101h9v9.5a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2Z" fill="#1c1b24" />
    <path d="M61.5 101h9v9.5a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2Z" fill="#1c1b24" />
    <rect x="47.5" y="110.5" width="12" height="5.5" rx="2.75" fill="#f5f5f7" />
    <rect x="60.5" y="110.5" width="12" height="5.5" rx="2.75" fill="#f5f5f7" />
    <path d="M48.5 114.6h10M61.5 114.6h10" stroke="#d1d1d6" stroke-width="0.9" stroke-linecap="round" />

    <!-- stage jacket over a white shirt -->
    <g class="pet-arm left">
      <rect x="41.5" y="78" width="7.5" height="17" rx="3.75" fill="#2a2937" transform="rotate(10 45 80)" />
      <circle cx="42" cy="96" r="3.4" fill="#ffe6d6" />
    </g>
    <g class="pet-arm right">
      <rect x="71" y="78" width="7.5" height="17" rx="3.75" fill="#2a2937" transform="rotate(-10 75 80)" />
      <circle cx="78" cy="96" r="3.4" fill="#ffe6d6" />
    </g>
    <rect x="56" y="66" width="8" height="10" rx="3.5" fill="#f3c9b0" />
    <path d="M44 103C43 89 47.5 76.5 60 75S77 89 76 103Z" fill={url('jacket')} />
    <path d="M55.2 75.4 60 87l4.8-11.6Z" fill="#fff" />
    <path d="M55.2 75.4 60 87 57.2 89.5 51.5 79.5Z" fill="#4a4860" />
    <path d="M64.8 75.4 60 87l2.8 2.5 5.7-10Z" fill="#4a4860" />
    <path d="M56.2 76.5Q60 81.5 63.8 76.5" fill="none" stroke="#e5e5ea" stroke-width="0.7" />
    <circle cx="63.6" cy="93" r="0.95" fill="#e8c37a" />
    <circle cx="63.6" cy="97.5" r="0.95" fill="#e8c37a" />
    <path d="M44.6 101.6H75.4" stroke="#e8c37a" stroke-width="0.9" stroke-linecap="round" opacity="0.85" />
    <path d="M48 80.5C49.5 78.5 51 77.6 53 77" stroke="#e8c37a" stroke-width="0.8" stroke-linecap="round" fill="none" opacity="0.8" />
    <path d="M72 80.5C70.5 78.5 69 77.6 67 77" stroke="#e8c37a" stroke-width="0.8" stroke-linecap="round" fill="none" opacity="0.8" />

    <!-- face -->
    <path d="M38 46C38 32 48 25 60 25S82 32 82 46C82 58.5 74 70 60 71 46 70 38 58.5 38 46Z" fill={url('skin')} />
    <path d="M55 69.5Q60 72.5 65 69.5" fill="none" stroke="#efc0a6" stroke-width="1" opacity="0.6" />
    <path d="M45.2 42.4Q50 40.8 55.4 42M64.6 42Q70 40.8 74.8 42.4" fill="none" stroke="#2b2230" stroke-width="1.8" stroke-linecap="round" />

    <g class="pet-look">
      <g class="pet-eyes">
        <ellipse cx="50.5" cy="51.5" rx="4.7" ry="5.5" fill={url('iris')} />
        <ellipse cx="69.5" cy="51.5" rx="4.7" ry="5.5" fill={url('iris')} />
        <ellipse cx="50.7" cy="52.2" rx="2.4" ry="3" fill="#120c10" />
        <ellipse cx="69.7" cy="52.2" rx="2.4" ry="3" fill="#120c10" />
        <circle cx="52.3" cy="49" r="1.9" fill="#fff" />
        <circle cx="71.3" cy="49" r="1.9" fill="#fff" />
        <circle cx="48.8" cy="54.4" r="0.95" fill="#fff" opacity="0.9" />
        <circle cx="67.8" cy="54.4" r="0.95" fill="#fff" opacity="0.9" />
        <path d="M45 48Q50.5 44 56.1 47.4M63.9 47.4Q69.5 44 75 48" fill="none" stroke="#17121a" stroke-width="1.7" stroke-linecap="round" />
      </g>
      <g class="pet-happy" fill="none" stroke="#2a1c22" stroke-width="2" stroke-linecap="round">
        <path d="M46 52.5Q50.5 47.5 55 52.5M65 52.5Q69.5 47.5 74 52.5" />
      </g>
      <path d="M60.3 56.6l-.7 1.3h1" fill="none" stroke="#e2ab90" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" />
      <path class="pet-mouth smile" d="M57.4 61Q60 63.4 62.6 61" fill="none" stroke="#9a3f4a" stroke-width="1.4" stroke-linecap="round" />
      <path class="pet-mouth open" d="M57.4 60.6Q60 61.3 62.6 60.6 62.3 64.6 60 64.8 57.7 64.6 57.4 60.6Z" fill="#9a3f4a" />
    </g>
    <ellipse cx="44.5" cy="58" rx="3.6" ry="2" fill="#ff8fa3" opacity="0.2" />
    <ellipse cx="75.5" cy="58" rx="3.6" ry="2" fill="#ff8fa3" opacity="0.2" />
    <path d="M42.6 58.6l1.1-1.6M44.6 58.6l1.1-1.6M46.6 58.6l1.1-1.6M73.4 58.6l1.1-1.6M75.4 58.6l1.1-1.6M77.4 58.6l1.1-1.6" stroke="#f08a9b" stroke-width="0.75" stroke-linecap="round" />

    <!-- side locks over the ears -->
    <path d="M38.5 38C33.5 44.5 32.6 54 34 62.5 34.8 65 36 66.6 37.6 67.4 38.2 63.6 39.4 60.4 41.3 57.4 40.2 51.5 40.4 45.5 42.8 41Z" fill={url('hair')} stroke="#1d1a25" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M81.5 38C86.5 44.5 87.4 54 86 62.5 85.2 65 84 66.6 82.4 67.4 81.8 63.6 80.6 60.4 78.7 57.4 79.8 51.5 79.6 45.5 77.2 41Z" fill={url('hair')} stroke="#1d1a25" stroke-width="1.6" stroke-linejoin="round" />
    <!-- swept comma bangs -->
    <path d="M35.5 45C33.5 28 46 16.5 61 16.5S87.5 27 85.5 42.5C83.5 39.5 80.5 37.6 77.5 37.2 78.6 40.6 77.8 44 75.6 46.6 73.8 41.6 69.6 38.2 64.4 37 65.6 41 64.6 44.6 61.6 47.6 59.6 41.8 55 38.4 49.6 38.2 51.4 42 50.6 45.6 47.6 48.4 46.4 44.2 43 41.2 39.2 41.6 37.8 42.6 36.5 43.6 35.5 45Z" fill={url('hair')} stroke="#1d1a25" stroke-width="2.2" stroke-linejoin="round" />
    <path d="M58 19.5C56 25 54 30.5 52.6 37M68 20.5C68.5 26 67.4 31.5 65.4 36.6M47 23.5C44.6 28 43 33 42.4 39" fill="none" stroke="#5a5070" stroke-width="0.8" stroke-linecap="round" opacity="0.45" />
    <path d="M45.5 25.5C51 20.8 59 19.6 67.5 21" fill="none" stroke="#fff" stroke-opacity="0.32" stroke-width="2.4" stroke-linecap="round" />
    <path d="M71.5 22.5C74 23.6 76 25.2 77.4 27" fill="none" stroke="#fff" stroke-opacity="0.22" stroke-width="1.8" stroke-linecap="round" />

    <!-- headset mic -->
    <path d="M82.6 50C82.4 58 77.5 63 70.5 63.4" fill="none" stroke="#2c2c2e" stroke-width="1.4" stroke-linecap="round" />
    <circle cx="69.8" cy="63.4" r="2.1" fill="#2c2c2e" />
    <circle class="pet-light" cx="69.8" cy="63.4" r="1" fill="#ff9f0a" />

    <!-- idol sparkles -->
    <path class="pet-spark s1" d="M101 18l1.6 4.4 4.4 1.6-4.4 1.6L101 30l-1.6-4.4L95 24l4.4-1.6Z" fill="#ffd60a" />
    <path class="pet-spark s2" d="M18 30l1.1 3 3 1.1-3 1.1L18 38.3l-1.1-3.1-3-1.1 3-1.1Z" fill="#bf5af2" />
  </g>
</svg>
