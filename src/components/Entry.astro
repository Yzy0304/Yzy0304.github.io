---
import Icon from './Icon.astro';

interface Props {
  entry: {
    title: string;
    org?: string;
    period: string;
    tags?: string[];
    bullets: string[];
    note?: string;
    link?: { label: string; href: string };
  };
}
const { entry } = Astro.props;
---

<article class="card entry">
  <div class="entry-head">
    <h3>{entry.title}</h3>
    <span class="period">{entry.period}</span>
  </div>
  {entry.org && <p class="org">{entry.org}</p>}
  {entry.tags && (
    <ul class="chips small">
      {entry.tags.map((t) => <li>{t}</li>)}
    </ul>
  )}
  <ul class="bullets">
    {entry.bullets.map((b) => <li>{b}</li>)}
  </ul>
  {entry.note && <p class="note">{entry.note}</p>}
  {entry.link && (
    <a class="read-more" href={entry.link.href}>{entry.link.label} <Icon name="arrow" size={15} /></a>
  )}
</article>
